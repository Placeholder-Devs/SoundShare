<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_dark">

    <ImageView
        android:id="@+id/ivDragHandle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_drag_handle"
        android:contentDescription="Drag to reorder"
        android:scaleType="centerInside"
        android:layout_marginEnd="6dp" />

    <TextView
        android:id="@+id/tvTrackNumber"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:text="1"
        android:textColor="@color/accent_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvQueueTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Song Title"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/tvQueueDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="3:45 | FLAC Lossless | 24 MB"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-light" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvQueueStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ready"
        android:textColor="@color/accent_cyan"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="8dp" />

    <ImageButton
        android:id="@+id/btnDownloadQueueItem"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_download"
        android:scaleType="centerInside"
        android:contentDescription="Save track to device"
        android:padding="6dp"
        android:layout_marginEnd="4dp"
        app:tint="@color/accent_cyan" />

    <ImageButton
        android:id="@+id/btnRemoveQueueItem"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_stop"
        android:scaleType="centerInside"
        android:contentDescription="Remove from queue"
        android:padding="6dp"
        app:tint="@color/text_hint" />

</LinearLayout>
