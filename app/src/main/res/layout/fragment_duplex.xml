<?xml version="1.0" encoding="utf-8"?>
<!-- Duplex Fragment: Bidirectional streaming mode -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollDuplex"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <!-- ====== HEADER ====== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duplex"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send and receive simultaneously"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif-light"
            android:paddingBottom="24dp" />

        <!-- ====== IP CARD ====== -->
        <LinearLayout
            android:id="@+id/duplexIpCardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_ip_card"
            android:padding="20dp"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Device IP"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/tvDuplexDeviceIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/accent_secondary"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.04"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to copy"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:fontFamily="sans-serif-light" />

            <!-- Peer IP input + Scan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/duplexIpInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="Peer IP (for join)"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:inputType="textUri"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="16dp"
                    android:fontFamily="sans-serif-light"
                    android:autofillHints="" />

                <Button
                    android:id="@+id/btnDuplexScan"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_blue"
                    android:stateListAnimator="@null"
                    android:paddingHorizontal="16dp"
                    android:text="Scan"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ====== HOST / JOIN / STOP BUTTONS ====== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnDuplexHost"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Host"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_button_green"
                android:drawableStart="@drawable/ic_stream"
                android:drawablePadding="8dp"
                android:drawableTint="#FFFFFF"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="8dp"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btnDuplexJoin"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Join"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_button_blue"
                android:drawableStart="@drawable/ic_connect"
                android:drawablePadding="8dp"
                android:drawableTint="#FFFFFF"
                android:paddingHorizontal="12dp"
                android:layout_marginStart="8dp"
                android:stateListAnimator="@null"
                android:elevation="0dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDuplexStop"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Stop Session"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_button_red"
            android:drawableStart="@drawable/ic_stop"
            android:drawablePadding="10dp"
            android:drawableTint="#FFFFFF"
            android:paddingHorizontal="18dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

        <!-- ====== QUALITY SPINNER (will be hidden programmatically) ====== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Quality"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <Spinner
                android:id="@+id/duplexQualitySpinner"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="180dp"
                android:background="@drawable/bg_spinner_dark"
                android:paddingHorizontal="12dp"
                android:popupBackground="@color/card_dark_elevated" />
        </LinearLayout>

        <!-- ====== STATUS ====== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="20dp">

            <View
                android:id="@+id/duplexStatusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_dot_orange"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/duplexStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif-light" />
        </LinearLayout>

        <!-- ====== STATS CARD ====== -->
        <LinearLayout
            android:id="@+id/duplexStatsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@drawable/bg_card_dark"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <!-- Connection status row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="14dp">

                <View
                    android:id="@+id/duplexStatusDotInner"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_status_dot_orange" />

                <TextView
                    android:id="@+id/tvDuplexConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Waiting..."
                    android:textSize="13sp"
                    android:textColor="@color/accent_orange"
                    android:fontFamily="sans-serif-light"
                    android:paddingStart="10dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_dark"
                android:layout_marginBottom="14dp" />

            <!-- Primary metrics: Send Rate, Recv Rate, Duration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Send Rate"
                        android:textSize="10sp"
                        android:textColor="@color/text_hint"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="true"
                        android:letterSpacing="0.04"
                        android:paddingBottom="4dp" />
                    <TextView
                        android:id="@+id/tvDuplexSendRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 kbps"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_cyan"
                        android:fontFamily="sans-serif-light" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/divider_dark"
                    android:layout_marginHorizontal="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recv Rate"
                        android:textSize="10sp"
                        android:textColor="@color/text_hint"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="true"
                        android:letterSpacing="0.04"
                        android:paddingBottom="4dp" />
                    <TextView
                        android:id="@+id/tvDuplexRecvRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 kbps"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_green"
                        android:fontFamily="sans-serif-light" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/divider_dark"
                    android:layout_marginHorizontal="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Duration"
                        android:textSize="10sp"
                        android:textColor="@color/text_hint"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="true"
                        android:letterSpacing="0.04"
                        android:paddingBottom="4dp" />
                    <TextView
                        android:id="@+id/tvDuplexDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_orange"
                        android:fontFamily="sans-serif-light" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_dark"
                android:layout_marginBottom="14dp" />

            <!-- Secondary metrics: Sample Rate, Ping, Channels -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sample Rate"
                        android:textSize="10sp"
                        android:textColor="@color/text_hint"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="true"
                        android:letterSpacing="0.04"
                        android:paddingBottom="4dp" />
                    <TextView
                        android:id="@+id/tvDuplexSampleRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-light" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/divider_dark"
                    android:layout_marginHorizontal="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ping"
                        android:textSize="10sp"
                        android:textColor="@color/text_hint"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="true"
                        android:letterSpacing="0.04"
                        android:paddingBottom="4dp" />
                    <TextView
                        android:id="@+id/tvDuplexPing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_pink"
                        android:fontFamily="sans-serif-light" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/divider_dark"
                    android:layout_marginHorizontal="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Channels"
                        android:textSize="10sp"
                        android:textColor="@color/text_hint"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="true"
                        android:letterSpacing="0.04"
                        android:paddingBottom="4dp" />
                    <TextView
                        android:id="@+id/tvDuplexChannels"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-light" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ====== NOW PLAYING CARD ====== -->
        <LinearLayout
            android:id="@+id/duplexNowPlayingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@drawable/bg_card_dark"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDuplexNowPlayingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SoundShare Stream"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvDuplexNowPlayingSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="48.0 kHz · Stereo · 16-bit PCM"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="sans-serif-light" />
                </LinearLayout>

                <View
                    android:id="@+id/duplexNowPlayingDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_status_dot_green"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDuplexNowPlayingElapsed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="12sp"
                android:textColor="@color/accent_secondary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center" />
        </LinearLayout>

        <!-- ====== CHAT CARD ====== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/duplexChatCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Chat header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Chat"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium" />

                    <View
                        android:id="@+id/duplexChatStatusDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_status_dot_orange"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvDuplexChatStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connecting"
                        android:textSize="11sp"
                        android:textColor="@color/accent_orange"
                        android:fontFamily="sans-serif-light" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_dark"
                    android:layout_marginBottom="12dp" />

                <!-- Chat messages -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDuplexChat"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:background="@android:color/transparent"
                    android:paddingVertical="6dp"
                    android:clipToPadding="false"
                    android:scrollbars="none"
                    android:overScrollMode="never" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_dark"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <!-- Chat input row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etDuplexChatInput"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="Message..."
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:inputType="textCapSentences|textAutoCorrect"
                        android:imeOptions="actionSend"
                        android:background="@drawable/bg_chat_input"
                        android:paddingHorizontal="16dp"
                        android:maxLines="1"
                        android:layout_marginEnd="10dp"
                        android:fontFamily="sans-serif-light"
                        android:autofillHints="" />

                    <ImageButton
                        android:id="@+id/btnDuplexChatSend"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_send_message"
                        android:background="@drawable/bg_button_send"
                        android:contentDescription="Send message"
                        android:padding="12dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
