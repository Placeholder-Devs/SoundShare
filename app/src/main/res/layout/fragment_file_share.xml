<?xml version="1.0" encoding="utf-8"?>
<!-- File Share Fragment: Symmetrical audio file queueing, synchronized high-res playback, time-synced lyrics & playlist management -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollFileShare"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <!-- ====== HEADER ====== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="File Share"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share audio files and play in sync"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif-light"
            android:paddingBottom="24dp" />

        <!-- ====== DEVICE IP CARD ====== -->
        <LinearLayout
            android:id="@+id/ipCardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_ip_card"
            android:padding="20dp"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Device IP"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/tvDeviceIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/accent_secondary"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.04"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to copy"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:fontFamily="sans-serif-light" />
        </LinearLayout>

        <!-- ====== CONNECT ZONE / PEER IP CARD ====== -->
        <LinearLayout
            android:id="@+id/peerIpContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_ip_card"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Host / Peer IP Address"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:paddingBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/peerIpInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="192.168.x.x"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:inputType="textUri"
                    android:imeOptions="actionGo"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="16dp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.04"
                    android:autofillHints="" />

                <Button
                    android:id="@+id/btnScan"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_blue"
                    android:stateListAnimator="@null"
                    android:paddingHorizontal="16dp"
                    android:text="Scan"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ====== HOST / JOIN ACTION BUTTONS ====== -->
        <LinearLayout
            android:id="@+id/hostJoinContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnHost"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Host Session"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_button_green"
                android:drawableStart="@drawable/ic_stream"
                android:drawablePadding="10dp"
                android:drawableTint="#FFFFFF"
                android:paddingHorizontal="16dp"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btnJoin"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Join Session"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_button_blue"
                android:drawableStart="@drawable/ic_connect"
                android:drawablePadding="10dp"
                android:drawableTint="#FFFFFF"
                android:paddingHorizontal="16dp"
                android:stateListAnimator="@null"
                android:elevation="0dp" />
        </LinearLayout>

        <!-- ====== CONNECTED ACTIONS (ADD SONGS / STOP) ====== -->
        <LinearLayout
            android:id="@+id/connectedActionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnPickSend"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Add Songs"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_button_orange"
                android:drawableStart="@drawable/ic_nav_fileshare"
                android:drawablePadding="10dp"
                android:drawableTint="#FFFFFF"
                android:paddingHorizontal="16dp"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:text="Stop"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_button_red"
                android:drawableStart="@drawable/ic_stop"
                android:drawablePadding="10dp"
                android:drawableTint="#FFFFFF"
                android:paddingHorizontal="20dp"
                android:stateListAnimator="@null"
                android:elevation="0dp" />
        </LinearLayout>

        <!-- ====== STATUS ====== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="20dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_dot_red"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Idle"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif-light" />
        </LinearLayout>

        <!-- ====== TRANSFER PROGRESS CARD ====== -->
        <LinearLayout
            android:id="@+id/transferCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="18dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="File Transfer"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/tvTransferPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_cyan"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/transferProgressBar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_progress_bar"
                android:indeterminate="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTransferStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Waiting..."
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="sans-serif-light" />

                <TextView
                    android:id="@+id/tvTransferSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_cyan"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>
        </LinearLayout>

        <!-- ====== STEREO CHANNEL SELECTOR CARD ====== -->
        <LinearLayout
            android:id="@+id/stereoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speaker Channel Mode (Wireless Stereo)"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:paddingBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnStereoBoth"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_button_green"
                    android:stateListAnimator="@null"
                    android:text="Stereo (L+R)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <Button
                    android:id="@+id/btnStereoLeft"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_ip_card"
                    android:stateListAnimator="@null"
                    android:text="Left (L)"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <Button
                    android:id="@+id/btnStereoRight"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_ip_card"
                    android:stateListAnimator="@null"
                    android:text="Right (R)"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- ====== NOW PLAYING / SYNC PLAYBACK CARD ====== -->
        <LinearLayout
            android:id="@+id/playbackCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Now Playing"
                android:textSize="11sp"
                android:textColor="@color/accent_primary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:paddingBottom="14dp" />

            <!-- Large Hero Album Artwork with Synced Bottom Lyrics Overlay -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAlbumArt"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="@color/card_dark_elevated">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivPlaybackAlbumArt"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_music_note"
                            android:contentDescription="Album Art" />

                        <!-- Gradient transition over photo on bottom -->
                        <View
                            android:id="@+id/lyricsPhotoGradient"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_photo_lyrics_gradient"
                            android:visibility="gone" />

                        <!-- Live synchronized lyric line over photo on bottom -->
                        <LinearLayout
                            android:id="@+id/layoutPhotoLyricsOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:paddingHorizontal="10dp"
                            android:paddingBottom="10dp"
                            android:gravity="center"
                            android:visibility="gone"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvLiveLyricLine"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:textColor="#FFFFFF"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:shadowColor="#D0000000"
                                android:shadowDx="0"
                                android:shadowDy="2"
                                android:shadowRadius="4"
                                android:text="" />
                        </LinearLayout>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvPlaybackTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="--"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvPlaybackArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Unknown Artist"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-light" />

                <TextView
                    android:id="@+id/tvPlaybackDetailsBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_ip_card"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="FLAC Lossless"
                    android:textColor="@color/accent_primary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBarPlayback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:max="100"
                android:progressTint="@color/accent_primary"
                android:thumbTint="@color/accent_primary"
                android:progressBackgroundTint="@color/seekbar_track" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlaybackElapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-light" />

                <TextView
                    android:id="@+id/tvPlaybackDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <!-- Transport Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnSyncSkipBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_media_button"
                    android:contentDescription="Previous track"
                    android:src="@drawable/ic_skip_previous"
                    android:scaleType="centerInside"
                    android:padding="12dp" />

                <ImageButton
                    android:id="@+id/btnSyncPlayPause"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/bg_media_button_large"
                    android:contentDescription="Play or Pause"
                    android:src="@drawable/ic_play"
                    android:scaleType="centerInside"
                    android:padding="15dp" />

                <ImageButton
                    android:id="@+id/btnSyncSkipFwd"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_media_button"
                    android:contentDescription="Next track"
                    android:src="@drawable/ic_skip_next"
                    android:scaleType="centerInside"
                    android:padding="12dp" />
            </LinearLayout>

            <!-- Lyrics & Download Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnToggleLyrics"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_ip_card"
                        android:paddingHorizontal="16dp"
                        android:text="Lyrics"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />

                    <Button
                        android:id="@+id/btnSaveCurrentTrack"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_ip_card"
                        android:paddingHorizontal="16dp"
                        android:text="Save to Device"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_cyan"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutLyricsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvLyricsHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Lyrics"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.06"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/tvLyricsSource"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fetching..."
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-light" />
                    </LinearLayout>

                    <!-- Time-Synchronized Lyrics List -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSyncedLyrics"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="10dp"
                        android:overScrollMode="ifContentScrolls"
                        android:visibility="gone" />

                    <!-- Plain Lyrics Fallback Text -->
                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/scrollLyrics"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="10dp"
                        android:overScrollMode="ifContentScrolls">

                        <TextView
                            android:id="@+id/tvLyricsContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:lineSpacingExtra="5dp"
                            android:text="Loading lyrics..."
                            android:textColor="@color/text_primary"
                            android:textIsSelectable="true"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-light" />
                    </androidx.core.widget.NestedScrollView>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ====== PLAYBACK QUEUE / PLAYLIST SECTION ====== -->
        <LinearLayout
            android:id="@+id/queueCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="18dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvQueueHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Playback Queue"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true" />

                <Button
                    android:id="@+id/btnAddQueueSongs"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_button_orange"
                    android:stateListAnimator="@null"
                    android:paddingHorizontal="14dp"
                    android:text="+ Add Audio"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPlaybackQueue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
