<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules (API 31+).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   The settings prefs (SettingsFragment.PREFS_NAME = "soundshare_settings") are
   tuned per device (buffer size, performance mode, socket multiplier, client
   name), so they are excluded from cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="soundshare_settings.xml" />
        <exclude domain="sharedpref" path="soundshare_battery_hint.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="soundshare_settings.xml" />
        <exclude domain="sharedpref" path="soundshare_battery_hint.xml" />
    </device-transfer>
</data-extraction-rules>
