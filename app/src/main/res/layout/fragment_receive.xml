<?xml version="1.0" encoding="utf-8"?>
<!-- Receive Fragment: Connect to a host/streamer -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollReceive"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <!-- ====== HEADER ====== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Receive"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect to a streaming device"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif-light"
            android:paddingBottom="24dp" />

        <!-- ====== CONNECT ZONE CARD ====== -->
        <LinearLayout
            android:id="@+id/connectZoneCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_ip_card"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Host IP Address"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:paddingBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/ipInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="192.168.x.x"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:inputType="textUri"
                    android:imeOptions="actionGo"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="16dp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.04"
                    android:autofillHints="" />

                <Button
                    android:id="@+id/btnScan"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_blue"
                    android:stateListAnimator="@null"
                    android:paddingHorizontal="16dp"
                    android:text="Scan"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ====== CONNECT BUTTON ====== -->
        <Button
            android:id="@+id/btnReceive"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Start Receiving"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_button_blue"
            android:drawableStart="@drawable/ic_connect"
            android:drawablePadding="10dp"
            android:drawableTint="#FFFFFF"
            android:paddingHorizontal="18dp"
            android:layout_marginBottom="16dp"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

        <!-- ====== STATUS ====== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="20dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_dot_orange"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif-light" />
        </LinearLayout>

        <!-- ====== STATS CARD ====== -->
        <LinearLayout
            android:id="@+id/statsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Connection status row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="14dp">

                    <View
                        android:id="@+id/statusDotInner"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_status_dot_orange" />

                    <TextView
                        android:id="@+id/tvConnectionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Waiting..."
                        android:textSize="13sp"
                        android:textColor="@color/accent_orange"
                        android:fontFamily="sans-serif-light"
                        android:paddingStart="10dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_dark"
                    android:layout_marginBottom="14dp" />

                <!-- Primary metrics: 3 columns -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bitrate"
                            android:textSize="10sp"
                            android:textColor="@color/text_hint"
                            android:fontFamily="sans-serif-medium"
                            android:textAllCaps="true"
                            android:letterSpacing="0.04"
                            android:paddingBottom="4dp" />
                        <TextView
                            android:id="@+id/tvBitrate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 kbps"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_cyan"
                            android:fontFamily="sans-serif-light" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/divider_dark"
                        android:layout_marginHorizontal="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Received"
                            android:textSize="10sp"
                            android:textColor="@color/text_hint"
                            android:fontFamily="sans-serif-medium"
                            android:textAllCaps="true"
                            android:letterSpacing="0.04"
                            android:paddingBottom="4dp" />
                        <TextView
                            android:id="@+id/tvTotalSent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 KB"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_green"
                            android:fontFamily="sans-serif-light" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/divider_dark"
                        android:layout_marginHorizontal="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Duration"
                            android:textSize="10sp"
                            android:textColor="@color/text_hint"
                            android:fontFamily="sans-serif-medium"
                            android:textAllCaps="true"
                            android:letterSpacing="0.04"
                            android:paddingBottom="4dp" />
                        <TextView
                            android:id="@+id/tvDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_orange"
                            android:fontFamily="sans-serif-light" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_dark"
                    android:layout_marginBottom="14dp" />

                <!-- Secondary metrics: 3 columns -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sample Rate"
                            android:textSize="10sp"
                            android:textColor="@color/text_hint"
                            android:fontFamily="sans-serif-medium"
                            android:textAllCaps="true"
                            android:letterSpacing="0.04"
                            android:paddingBottom="4dp" />
                        <TextView
                            android:id="@+id/tvSampleRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-light" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Format"
                            android:textSize="10sp"
                            android:textColor="@color/text_hint"
                            android:fontFamily="sans-serif-medium"
                            android:textAllCaps="true"
                            android:letterSpacing="0.04"
                            android:paddingBottom="4dp" />
                        <TextView
                            android:id="@+id/tvFormat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-light" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Latency"
                            android:textSize="10sp"
                            android:textColor="@color/text_hint"
                            android:fontFamily="sans-serif-medium"
                            android:textAllCaps="true"
                            android:letterSpacing="0.04"
                            android:paddingBottom="4dp" />
                        <TextView
                            android:id="@+id/tvLatency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_pink"
                            android:fontFamily="sans-serif-light" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ====== NOW PLAYING CARD ====== -->
        <LinearLayout
            android:id="@+id/nowPlayingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@drawable/bg_card_dark"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <!-- Hero Album Artwork Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginBottom="14dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/receiveCardAlbumArt"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="@color/card_dark_elevated">

                    <ImageView
                        android:id="@+id/ivReceiveAlbumArt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_music_note"
                        android:padding="16dp"
                        android:contentDescription="Album Art" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNowPlayingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SoundShare Stream"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvNowPlayingSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="48.0 kHz · Stereo · 16-bit PCM"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="sans-serif-light" />
                </LinearLayout>

                <View
                    android:id="@+id/nowPlayingDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_status_dot_green"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp" />

                <ImageButton
                    android:id="@+id/btnPlayPauseMini"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_pause"
                    android:background="@drawable/bg_media_button"
                    android:contentDescription="Play or Pause"
                    android:padding="14dp" />
            </LinearLayout>

            <!-- Transport controls row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="4dp">

                <ImageButton
                    android:id="@+id/btnSkipPrev"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_skip_previous"
                    android:background="@drawable/bg_media_button"
                    android:contentDescription="Skip back"
                    android:padding="12dp"
                    android:layout_marginEnd="16dp" />

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_play"
                    android:background="@drawable/bg_media_button_large"
                    android:contentDescription="Play or Pause"
                    android:padding="16dp"
                    android:layout_marginHorizontal="16dp" />

                <ImageButton
                    android:id="@+id/btnSkipNext"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_skip_next"
                    android:background="@drawable/bg_media_button"
                    android:contentDescription="Skip forward"
                    android:padding="12dp"
                    android:layout_marginStart="16dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNowPlayingElapsed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="12sp"
                android:textColor="@color/accent_secondary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/tvNowPlayingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live"
                android:textSize="11sp"
                android:textColor="@color/accent_green"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_gravity="center"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- ====== CHAT CARD ====== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/chatCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Chat header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Chat"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium" />

                    <View
                        android:id="@+id/chatStatusDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_status_dot_orange"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvChatStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connecting"
                        android:textSize="11sp"
                        android:textColor="@color/accent_orange"
                        android:fontFamily="sans-serif-light" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_dark"
                    android:layout_marginBottom="12dp" />

                <!-- Chat messages -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvChat"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:background="@android:color/transparent"
                    android:paddingVertical="6dp"
                    android:clipToPadding="false"
                    android:scrollbars="none"
                    android:overScrollMode="never" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_dark"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <!-- Chat input row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etChatInput"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="Message..."
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:inputType="textCapSentences|textAutoCorrect"
                        android:imeOptions="actionSend"
                        android:background="@drawable/bg_chat_input"
                        android:paddingHorizontal="16dp"
                        android:maxLines="1"
                        android:layout_marginEnd="10dp"
                        android:fontFamily="sans-serif-light"
                        android:autofillHints="" />

                    <ImageButton
                        android:id="@+id/btnChatSend"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_send_message"
                        android:background="@drawable/bg_button_send"
                        android:contentDescription="Send message"
                        android:padding="12dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
