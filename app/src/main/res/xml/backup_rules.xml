<?xml version="1.0" encoding="utf-8"?><!--
   Full-backup rules (used on API 30 and lower; this app's minSdk is 31, so
   data_extraction_rules.xml is the one that applies on supported devices).
   See https://developer.android.com/guide/topics/data/autobackup

   The settings prefs (SettingsFragment.PREFS_NAME = "soundshare_settings") are
   tuned per device (buffer size, performance mode, socket multiplier, client
   name), so they are not backed up or restored onto another phone.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="soundshare_settings.xml" />
    <exclude domain="sharedpref" path="soundshare_battery_hint.xml" />
</full-backup-content>
